# Integration Co-Worker Environment Configuration
# Copy to .env and fill in your values. Never commit .env (it contains secrets).

# ============================================================================
# Database
# ============================================================================

# Postgres connection URL (primary database)
# NOTE: Default port is 15432 to avoid conflicts with local Postgres installations.
# The docker-compose.yml maps container port 5432 → host port 15432.
DATABASE_URL=postgresql://integration:integration@localhost:15432/integration_coworker

# Optional: Override the host port for Postgres/Redis in docker-compose
# DB_HOST_PORT=15432
# REDIS_HOST_PORT=6379

# Use SQLite instead of Postgres (for local testing only)
# USE_SQLITE=true

# ============================================================================
# LLM Providers
# ============================================================================

# Set at least one provider key for real calls
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Mock mode for offline/dev runs
# USE_MOCK_LLM=true

# Optional overrides
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://your-instance.openai.azure.com/

# ============================================================================
# Tracing (LangSmith)
# ============================================================================

# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=

# ============================================================================
# Validation Profiles (pytest)
# ============================================================================

# VALIDATION_PROFILE=offline  # offline | record | live
# ALLOW_RECORD=0              # set to 1 to enable record profile
# ALLOW_LIVE=0                # set to 1 to enable live profile
# LIVE_HOST_ALLOWLIST=api.example.com,another.example.com

# ============================================================================
# Live Validation (Sandbox Real API Calls)
# ============================================================================
# 
# To enable live API validation in generated code sandboxes:
#
# 1. Set ALLOW_LIVE=1 (safety guard)
# 2. Set LIVE_HOST_ALLOWLIST with allowed API hosts (comma-separated)
# 3. Set LIVE_ENV_PASSTHROUGH with env var NAMES to inject (comma-separated)
# 4. Ensure the actual API keys are set in your environment
#
# Example for OpenAI spec validation:
#   ALLOW_LIVE=1
#   LIVE_HOST_ALLOWLIST=api.openai.com
#   LIVE_ENV_PASSTHROUGH=OPENAI_API_KEY
#   OPENAI_API_KEY=sk-...  # (already set above)
#
# Example for multiple specs:
#   LIVE_HOST_ALLOWLIST=api.openai.com,api.stripe.com
#   LIVE_ENV_PASSTHROUGH=OPENAI_API_KEY,STRIPE_SECRET_KEY
#   STRIPE_SECRET_KEY=sk_test_...
#
# SECURITY: Only the env vars listed in LIVE_ENV_PASSTHROUGH are injected
# into the sandbox. Other secrets remain isolated.

# ALLOW_LIVE=0
# LIVE_HOST_ALLOWLIST=
# LIVE_ENV_PASSTHROUGH=
