# Copy to .env and fill in values.
# Never commit .env (it contains secrets).

# Persistence
export DATABASE_URL=postgresql://integration:integration@localhost:5432/integration_coworker

# LLM provider keys (set at least one)
export OPENAI_API_KEY=
export ANTHROPIC_API_KEY=
export GOOGLE_API_KEY=

# Optional tracing (LangSmith)
export LANGCHAIN_TRACING_V2=false
export LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
export LANGCHAIN_API_KEY=
export LANGCHAIN_PROJECT=

# Mode toggles
# Set to false for real LLM calls
export USE_MOCK_LLM=false
export USE_SQLITE=false
# Integration Co-Worker Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Database Configuration
# ============================================================================

# Postgres connection URL (primary database for production)
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://integration:integration@localhost:5432/integration_coworker"

# Use SQLite instead of Postgres (for testing only)
# When set to "true", DATABASE_URL is ignored
# USE_SQLITE=true

# ============================================================================
# LLM Configuration
# ============================================================================

# OpenAI API key (required for real LLM calls)
OPENAI_API_KEY=sk-your-api-key-here

# Anthropic API key (optional, for future use)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Use mock LLM instead of real API (for testing without API key)
# USE_MOCK_LLM=true

# Override the default model (optional, defaults to gpt-4)
# LLM_MODEL=gpt-4-turbo-preview

# Custom base URL for Azure OpenAI or other compatible APIs (optional)
# LLM_BASE_URL=https://your-instance.openai.azure.com/

# ============================================================================
# Embedding Configuration
# ============================================================================

# Override the embedding model (optional, defaults to text-embedding-3-small)
# EMBEDDING_MODEL=text-embedding-3-large
