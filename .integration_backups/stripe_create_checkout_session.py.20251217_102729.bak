"""
Stripe Create Checkout Session Flow

Auto-generated by Integration Co-Worker
Task: Create a checkout session
"""
from typing import Dict, Any, Optional
from integrations.clients.stripe import StripeClient
from integrations.clients.stripe import IntegrationError


def create_checkout_session_flow(
    api_key: str,
    payload: Dict[str, Any],
    **kwargs: Any,
) -> Dict[str, Any]:
    """
    Execute the create checkout session workflow.
    
    This flow:
    1. Validates input parameters
    2. Calls the stripe API
    3. Transforms and returns the response
    
    Args:
        api_key: API authentication key
        payload: Request payload for the API. Should contain required fields
            such as 'line_items' or 'price', 'success_url', 'cancel_url', etc.
        **kwargs: Additional options (e.g., idempotency_key)
    
    Returns:
        Dict containing the API response with relevant fields including:
            - success: Boolean indicating if the operation succeeded
            - data: The complete checkout session object from Stripe
            - session_id: The ID of the created checkout session (if available)
            - url: The checkout URL to redirect the customer to (if available)
    
    Raises:
        ValueError: If required input is missing or invalid
        IntegrationError: If the API call fails
    """
    # Step 1: Validate input
    if not api_key:
        raise ValueError("api_key is required")
    
    if not payload:
        raise ValueError("payload is required")
    
    if not isinstance(payload, dict):
        raise ValueError("payload must be a dictionary")
    
    # Validate critical payload fields
    required_fields = ['success_url', 'cancel_url']
    missing_fields = [field for field in required_fields if field not in payload]
    
    if missing_fields:
        raise ValueError(
            f"payload is missing required fields: {', '.join(missing_fields)}"
        )
    
    # Validate that either line_items or a price/mode combination exists
    has_line_items = 'line_items' in payload
    has_mode = 'mode' in payload
    
    if not has_line_items and not has_mode:
        raise ValueError(
            "payload must contain either 'line_items' or 'mode' for checkout session"
        )
    
    # Step 2: Call the API
    client = StripeClient(api_key=api_key)
    idempotency_key = kwargs.get("idempotency_key")
    
    try:
        response = client.post_checkout_sessions(
            payload=payload,
            idempotency_key=idempotency_key,
        )
    except IntegrationError as e:
        raise IntegrationError(f"Failed to create checkout session: {str(e)}") from e
    except Exception as e:
        raise IntegrationError(f"Unexpected error during API call: {str(e)}") from e
    
    # Step 3: Transform and return response
    result = {
        "success": True,
        "data": response,
    }
    
    # Extract commonly used fields for convenience
    if isinstance(response, dict):
        if "id" in response:
            result["session_id"] = response["id"]
        if "url" in response:
            result["url"] = response["url"]
        if "status" in response:
            result["status"] = response["status"]
        if "payment_status" in response:
            result["payment_status"] = response["payment_status"]
    
    return result