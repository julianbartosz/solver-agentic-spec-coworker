            assert result["data"]["status"] == "open"
            assert result["data"]["object"] == "checkout.session"
            
            # Verify client was called correctly
            mock_client.post_checkout_sessions.assert_called_once()
            call_args = mock_client.post_checkout_sessions.call_args
