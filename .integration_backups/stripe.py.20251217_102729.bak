            >>> session = client.post_checkout_sessions(payload)
            >>> redirect_url = session["url"]
        """
        url = f"{self.base_url}/v1/checkout/sessions"
        
        headers = {
            "Content-Type": "application/x-www-form-urlencoded"
        }
        
        if self.api_key:
