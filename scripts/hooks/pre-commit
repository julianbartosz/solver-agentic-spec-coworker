#!/bin/bash
# =============================================================================
# Pre-commit hook: Validate Python environment
# =============================================================================
# This hook prevents commits when the Python environment has issues that could
# cause production failures (like the mixed site-packages bug).
#
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or run: ./scripts/setup_env.sh --install-hooks
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# If we're in .git/hooks, go up to project root
if [[ "$SCRIPT_DIR" == *"/.git/hooks" ]]; then
    PROJECT_ROOT="${SCRIPT_DIR%/.git/hooks}"
else
    PROJECT_ROOT="$(dirname "$(dirname "$SCRIPT_DIR")")"
fi

VENV_PATH="$PROJECT_ROOT/.venv311"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Quick sanity check - don't block commits for minor issues
quick_check() {
    # 1. Check venv exists
    if [[ ! -d "$VENV_PATH" ]]; then
        echo -e "${YELLOW}[pre-commit] Warning: .venv311 not found. Run ./scripts/setup_env.sh${NC}"
        return 0  # Don't block, just warn
    fi
    
    # 2. Check for the specific bug we hit: multiple Python versions in site-packages
    local site_packages_count=$(ls -d "$VENV_PATH/lib/"python* 2>/dev/null | wc -l)
    if [[ $site_packages_count -gt 1 ]]; then
        echo -e "${RED}[pre-commit] ERROR: Mixed Python versions detected in .venv311!${NC}"
        echo -e "${RED}This causes package conflicts. Run: ./scripts/setup_env.sh --clean${NC}"
        return 1
    fi
    
    # 3. Quick import test for the specific failure we saw
    if ! "$VENV_PATH/bin/python" -c "from langgraph.checkpoint.serde.jsonplus import JsonPlusSerializer; JsonPlusSerializer().dumps" 2>/dev/null; then
        echo -e "${RED}[pre-commit] ERROR: LangGraph checkpoint serialization broken!${NC}"
        echo -e "${RED}Run: ./scripts/setup_env.sh --clean${NC}"
        return 1
    fi
    
    echo -e "${GREEN}[pre-commit] Environment check passed${NC}"
    return 0
}

quick_check
